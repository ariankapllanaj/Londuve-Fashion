# ─────────────────────────────────────────────────────────────
#  LONDUVE — Apache settings for classic web hosting (e.g. Hostpoint)
#  Copied into dist/ by every build. Ignored by GitHub Pages.
#  Every block is wrapped in <IfModule> so a missing module can't break the site.
#  If the host ever shows "500 Internal Server Error", delete this file — the site works without it.
# ─────────────────────────────────────────────────────────────

# Always use HTTPS (turn on the free SSL certificate for the domain first)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# File types used by the site (3D model, images, fonts)
<IfModule mod_mime.c>
  AddType model/gltf-binary .glb
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType font/woff .woff
</IfModule>

# Compress text files
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml model/gltf-binary
</IfModule>

# Caching: hashed build files never change → cache for a year; index.html always fresh
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(glb|webp|png|jpg)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

